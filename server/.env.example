# Server Port
PORT=3000

# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/nexa

# JWT Auth Configuration
JWT_SECRET=nexa-super-secret-change-in-production
JWT_EXPIRES_IN=7d

# Redis Configuration (BullMQ Queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Encryption Key (AES-256-GCM - exactly 32 chars)
ENCRYPTION_KEY=nexa-encryption-key-32-chars-long

# Google OAuth 2.0 (GBP API)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/gbp/oauth2callback

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-meta-cloud-api-access-token
WHATSAPP_VERIFY_TOKEN=nexa-webhook-verify
WHATSAPP_WEBHOOK_SECRET=your-app-secret

# AI Providers & Guardrails Layer
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
AI_DEFAULT_MODEL=gemini-1.5-flash
